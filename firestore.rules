rules_version = '2';

// Demo/learning rules: anyone can read and write the workouts collection.
// Fine for a class project or personal demo; add Firebase Authentication
// and scope these rules to request.auth.uid before using this with real users.
service cloud.firestore {
  match /databases/{database}/documents {
    match /workouts/{workoutId} {
      allow read, write: if true;
    }
  }
}
